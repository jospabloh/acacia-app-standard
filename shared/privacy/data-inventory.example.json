{
  "notice_version": 1,
  "notice_hash": "sha256:<computed by CI over the generator's output>",
  "platform_fields": {
    "created_by": {
      "label": "Correo de la cuenta que creó el registro",
      "category": "contact",
      "titular": "account_user",
      "derived_from": "User.email",
      "purposes": [
        "record_authorship"
      ],
      "retention": "Mientras exista el registro",
      "deletion": "Se vuelve anónimo al borrar la cuenta",
      "minors": false,
      "acacia_role": "responsable"
    }
  },
  "titulares": {
    "account_user": {
      "label": "Titular de la cuenta"
    },
    "tenant_customer": {
      "label": "Clientes del negocio"
    },
    "arco_requester": {
      "label": "Quien presenta una solicitud sobre sus datos"
    }
  },
  "purposes": {
    "provide_service": {
      "label": "Crear tu cuenta y darte el servicio",
      "requires_consent": false
    },
    "billing": {
      "label": "Cobrar y facturar tu suscripción",
      "requires_consent": false
    },
    "support": {
      "label": "Atender tus solicitudes de soporte",
      "requires_consent": false
    },
    "session_security": {
      "label": "Proteger tu cuenta y tus sesiones",
      "requires_consent": false
    },
    "debugging": {
      "label": "Diagnosticar fallas del servicio",
      "requires_consent": false
    },
    "product_news": {
      "label": "Enviarte novedades de ACACIA",
      "requires_consent": true
    },
    "fulfil_orders": {
      "label": "Surtir y entregar tus pedidos",
      "requires_consent": false
    },
    "marketing_whatsapp": {
      "label": "Enviarte promociones por WhatsApp",
      "requires_consent": true
    },
    "insurance_quote": {
      "label": "Cotizarte un seguro para tu compra",
      "requires_consent": true
    },
    "record_authorship": {
      "label": "Saber qué cuenta creó o modificó cada registro",
      "requires_consent": false
    },
    "arco_request": {
      "label": "Atender tu solicitud de derechos ARCO y verificar tu identidad",
      "requires_consent": false
    }
  },
  "recipients": {
    "base44": {
      "label": "Base44",
      "role": "encargado",
      "does": "Hospeda la app y su base de datos",
      "country": "US"
    },
    "mission-control": {
      "label": "Panel interno de ACACIA",
      "role": "encargado",
      "does": "Concentra licencias y soporte",
      "country": "US"
    },
    "mercado-pago": {
      "label": "Mercado Pago",
      "role": "encargado",
      "does": "Cobra la suscripción",
      "country": "MX"
    },
    "meta-whatsapp": {
      "label": "WhatsApp (Meta)",
      "role": "encargado",
      "does": "Entrega los mensajes que envía el negocio",
      "country": "US"
    },
    "insurer-x": {
      "label": "Aseguradora X",
      "role": "third_party",
      "does": "Cotiza un seguro",
      "country": "MX",
      "legal_basis": null
    }
  },
  "entities": {
    "User": {
      "titular": "account_user",
      "minors": false,
      "acacia_role": "responsable",
      "fields": {
        "full_name": {
          "label": "Nombre",
          "category": "identification"
        },
        "email": {
          "label": "Correo",
          "category": "contact"
        },
        "phone": {
          "label": "Teléfono",
          "category": "contact"
        }
      },
      "non_personal_fields": [
        "role",
        "tenant_id"
      ],
      "purposes": [
        "provide_service",
        "billing",
        "product_news"
      ],
      "retention": "Mientras exista tu cuenta",
      "deletion": "Se elimina al borrar la cuenta"
    },
    "Client": {
      "titular": "tenant_customer",
      "minors": false,
      "acacia_role": "encargado",
      "fields": {
        "name": {
          "label": "Nombre",
          "category": "identification"
        },
        "phone": {
          "label": "Teléfono",
          "category": "contact"
        },
        "rfc": {
          "label": "RFC",
          "category": "fiscal"
        }
      },
      "non_personal_fields": [
        "price_list_id",
        "credit_days",
        "active"
      ],
      "purposes": [
        "fulfil_orders",
        "marketing_whatsapp",
        "insurance_quote"
      ],
      "retention": "Mientras el negocio use la app; los datos fiscales, el tiempo que exige la ley",
      "deletion": "Se vuelven anónimos nombre, teléfono y RFC; se conservan las operaciones"
    },
    "SupportTicketMessage": {
      "titular": "account_user",
      "minors": false,
      "acacia_role": "responsable",
      "fields": {
        "body": {
          "label": "Lo que escribes en tu solicitud",
          "category": "identification"
        },
        "attachments": {
          "label": "Archivos que adjuntas",
          "category": "identification"
        }
      },
      "non_personal_fields": [
        "ticket_id",
        "author_role"
      ],
      "purposes": [
        "support"
      ],
      "retention": "Mientras exista tu cuenta",
      "deletion": "Se elimina junto con la solicitud"
    }
  },
  "no_personal_data": {
    "Product": [
      "name",
      "sku",
      "price",
      "stock"
    ],
    "Warehouse": [
      "name",
      "active"
    ]
  },
  "collection_points": [
    {
      "id": "signup",
      "kind": "signup",
      "path": "src/pages/Register.jsx",
      "handler": "platform:auth",
      "filled_by": "titular",
      "collects": [
        "User.full_name",
        "User.email",
        "User.phone",
        "store:auth_and_sessions"
      ],
      "purposes": [
        "provide_service",
        "billing",
        "product_news",
        "session_security"
      ],
      "notice": "acacia"
    },
    {
      "id": "login",
      "kind": "login",
      "path": "src/pages/Login.jsx",
      "handler": "session#start",
      "filled_by": "titular",
      "collects": [
        "store:auth_and_sessions"
      ],
      "purposes": [
        "session_security"
      ],
      "notice": "acacia"
    },
    {
      "id": "public_order",
      "kind": "public_form",
      "path": "src/pages/PublicOrder.jsx",
      "handler": "orders#createPublicOrder",
      "filled_by": "titular",
      "collects": [
        "Client.name",
        "Client.phone"
      ],
      "purposes": [
        "fulfil_orders",
        "marketing_whatsapp",
        "insurance_quote"
      ],
      "notice": "tenant"
    },
    {
      "id": "client_import",
      "kind": "import",
      "path": "src/pages/Clients.jsx",
      "handler": "clients#importClients",
      "filled_by": "tenant_staff",
      "collects": [
        "Client.name",
        "Client.phone",
        "Client.rfc"
      ],
      "purposes": [
        "fulfil_orders"
      ],
      "notice": "tenant",
      "notice_to_titular": "sent"
    },
    {
      "id": "support_form",
      "kind": "form",
      "path": "src/pages/Support.jsx",
      "handler": "support#submitTicket",
      "filled_by": "titular",
      "collects": [
        "SupportTicketMessage.body",
        "SupportTicketMessage.attachments"
      ],
      "purposes": [
        "support"
      ],
      "notice": "acacia"
    },
    {
      "id": "arco_intake",
      "kind": "public_form",
      "path": "control.acaciaco.com.mx/arco",
      "handler": "external:mission-control#arco-intake",
      "filled_by": "titular",
      "collects": [
        "store:mission_control"
      ],
      "purposes": [
        "arco_request"
      ],
      "notice": "acacia"
    }
  ],
  "stores": {
    "auth_and_sessions": {
      "producers": [
        "platform",
        "functions/session/entry.ts"
      ],
      "non_personal_keys": [
        "session_id",
        "last_seen"
      ],
      "holds": [
        {
          "ref": "User.email",
          "key": "email",
          "recipient": "base44",
          "retention": "Mientras exista tu cuenta",
          "deletion": "Se elimina al borrar la cuenta"
        },
        {
          "keys": [
            "password_hash"
          ],
          "label": "Tu contraseña, cifrada",
          "category": "credentials",
          "titular": "account_user",
          "minors": false,
          "acacia_role": "responsable",
          "purposes": [
            "provide_service"
          ],
          "recipient": "base44",
          "retention": "Mientras exista tu cuenta",
          "deletion": "Se elimina al borrar la cuenta",
          "written_by": [
            "platform"
          ]
        },
        {
          "keys": [
            "access_token",
            "refresh_token"
          ],
          "label": "Los identificadores de tu sesión",
          "category": "credentials",
          "titular": "account_user",
          "minors": false,
          "acacia_role": "responsable",
          "purposes": [
            "session_security"
          ],
          "recipient": "base44",
          "retention": "Hasta que cierras sesión o expiran",
          "deletion": "Se eliminan al cerrar sesión",
          "written_by": [
            "platform"
          ]
        },
        {
          "keys": [
            "ip_address",
            "user_agent"
          ],
          "label": "Dirección IP y navegador",
          "category": "identification",
          "titular": "account_user",
          "minors": false,
          "acacia_role": "responsable",
          "purposes": [
            "session_security"
          ],
          "recipient": "base44",
          "retention": "Se revoca tras 48 horas sin actividad",
          "deletion": "Se elimina con la sesión",
          "written_by": [
            "session#start"
          ]
        }
      ]
    },
    "files": {
      "producers": [
        "functions/support/entry.ts"
      ],
      "non_personal_keys": [
        "content_type",
        "size"
      ],
      "holds": [
        {
          "ref": "SupportTicketMessage.attachments",
          "key": "file",
          "recipient": "base44",
          "retention": "Mientras exista la solicitud",
          "deletion": "Se elimina el archivo junto con la solicitud"
        }
      ]
    },
    "logs": {
      "producers": [
        "platform"
      ],
      "non_personal_keys": [],
      "holds": [
        {
          "keys": [
            "ip_address",
            "user_agent"
          ],
          "label": "Dirección IP y navegador en los registros técnicos",
          "category": "identification",
          "titular": "account_user",
          "minors": false,
          "acacia_role": "responsable",
          "purposes": [
            "debugging"
          ],
          "recipient": "base44",
          "retention": "Cerca de 13 horas, según la plataforma",
          "deletion": "Expira sola; no puede eliminarse a solicitud",
          "written_by": [
            "platform"
          ]
        }
      ]
    },
    "analytics": {
      "producers": [],
      "non_personal_keys": [],
      "holds": []
    },
    "browser_storage": {
      "producers": [
        "src/lib/storage.js"
      ],
      "non_personal_keys": [
        "theme"
      ],
      "holds": []
    },
    "outbound_messages": {
      "producers": [
        "functions/notify/entry.ts",
        "functions/insurance/entry.ts"
      ],
      "non_personal_keys": [
        "template_id"
      ],
      "holds": [
        {
          "ref": "Client.phone",
          "key": "to",
          "recipient": "meta-whatsapp",
          "retention": "La que fija WhatsApp",
          "deletion": "No puede eliminarse desde la app"
        },
        {
          "ref": "Client.name",
          "key": "template_params.name",
          "recipient": "meta-whatsapp",
          "retention": "La que fija WhatsApp",
          "deletion": "No puede eliminarse desde la app"
        },
        {
          "ref": "Client.name",
          "key": "quote.customer_name",
          "recipient": "insurer-x",
          "retention": "La que fija la aseguradora",
          "deletion": "Se solicita a la aseguradora"
        },
        {
          "ref": "User.email",
          "key": "payer.email",
          "recipient": "mercado-pago",
          "retention": "La que fija Mercado Pago",
          "deletion": "No puede eliminarse desde la app"
        }
      ]
    },
    "mission_control": {
      "producers": [
        "functions/acaciaControl/entry.ts"
      ],
      "non_personal_keys": [
        "billing_status",
        "plan"
      ],
      "holds": [
        {
          "ref": "User.email",
          "key": "owner_email",
          "recipient": "mission-control",
          "retention": "Mientras exista la licencia",
          "deletion": "Se solicita por el puente y se confirma"
        },
        {
          "ref": "SupportTicketMessage.body",
          "key": "ticket.body",
          "recipient": "mission-control",
          "retention": "Mientras exista la solicitud",
          "deletion": "Se solicita por el puente y se confirma"
        },
        {
          "keys": [
            "requester_name",
            "requester_contact",
            "identity_document"
          ],
          "label": "Tu nombre, un medio de contacto y el documento con que acreditas tu identidad",
          "category": "identification",
          "titular": "arco_requester",
          "minors": false,
          "acacia_role": "responsable",
          "purposes": [
            "arco_request"
          ],
          "recipient": "mission-control",
          "retention": "Hasta resolver la solicitud y el plazo para inconformarte",
          "deletion": "Se elimina el documento al cerrar ese plazo",
          "written_by": [
            "external:mission-control#arco-intake"
          ]
        }
      ]
    }
  }
}
